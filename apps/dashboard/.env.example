# Dashboard settings for local development. Copy to apps/dashboard/.env.local (git-ignored). No secrets here, ever.

# Where the map asks for images. Keep the default: Vite proxies /geoserver to the target below, so the browser stays same-origin (no CORS).
VITE_GEOSERVER_WMS_URL=/geoserver/wms

# Where `npm run dev:dashboard` proxies /geoserver to (optional). Default: the pre-production portal (http://27.100.38.131:8070),
# whose nginx serves the DEDICATED GeoServer through a read-only proxy (WMS/WFS/OWS). Do NOT use the shared GeoServer 162.245.218.6.
# VITE_DEV_GEOSERVER_TARGET=http://27.100.38.131:8070

# Base URL of the search/chart API. Keep the default: Vite proxies /api to apps/server (npm run dev:server), nginx does it live.
VITE_API_URL=/api
