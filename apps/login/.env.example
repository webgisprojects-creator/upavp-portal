# Copy to .env.production.local (git-ignored) for a local production build, or set as a CI secret.

# Where a successful sign-in sends the user (the dashboard, served by the same nginx).
VITE_DASHBOARD_PATH=/AwasVikas/

# TEMPORARY demo sign-in (JSON list). Visible in the browser bundle - not real security.
# Leave empty to disable sign-in entirely.
VITE_DEMO_USERS='[{"username":"demo","password":"change-me"}]'

# Future: real authentication endpoint (POST {username, password}); see docs/architecture.md.
# VITE_LOGIN_ENDPOINT=
# VITE_FORGOT_PASSWORD_URL=
