# Copy to apps/server/.env (git-ignored). Never commit real values.
PORT=3001

# Map data goes through the DEDICATED GeoServer (on the server: http://127.0.0.1:8081/geoserver/wfs).
# From a developer machine use the pre-production portal's read-only proxy:
GEOSERVER_WFS_URL=http://27.100.38.131:8070/geoserver/wfs

# Database (PgBouncer is on 6432, PostgreSQL on 5432). Use the least-privileged role: upavp_geo_app on servers, upavp_geo_dev locally.
DB_HOST=27.100.38.132
DB_PORT=5432
DB_NAME=upavp_geo
DB_USER=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

LAYOUT_SCHEMA=lucknow
LAYOUT_TABLE=vrindavan_layout
LAYOUT_SCHEME_FIELD=scheme
LAYOUT_SECTOR_FIELD=sector
LAYOUT_PLOT_FIELD=plot_no_
LAYOUT_GEOMETRY_FIELD=geom
